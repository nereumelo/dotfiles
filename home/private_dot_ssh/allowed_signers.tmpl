{{- /* Principals for git verify-commit / log --show-signature */ -}}
{{- $personalPub := joinPath .chezmoi.homeDir ".ssh/home-personal.pub" -}}
{{- if stat $personalPub -}}
{{- $parts := splitList " " (trim (output "cat" $personalPub)) -}}
{{ .git.email }} namespaces="git" {{ index $parts 0 }} {{ index $parts 1 }}
{{- end -}}
{{- range $key, $val := .git }}
{{- if and (kindIs "map" $val) (index $val "email") }}
{{- $pub := joinPath $.chezmoi.homeDir ".ssh" (printf "%s.pub" $key) }}
{{- if stat $pub }}
{{- $orgParts := splitList " " (trim (output "cat" $pub)) }}
{{ index $val "email" }} namespaces="git" {{ index $orgParts 0 }} {{ index $orgParts 1 }}
{{- end }}
{{- end }}
{{- end }}
