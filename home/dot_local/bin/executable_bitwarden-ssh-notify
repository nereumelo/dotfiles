#!/usr/bin/env python3
"""Proxy Bitwarden's SSH agent socket and alert on sign (key usage) requests.

OpenSSH IdentityAgent / SSH_AUTH_SOCK should point at the notify socket.
The real Bitwarden socket stays ~/.bitwarden-ssh-agent.sock.
"""
from __future__ import annotations

import os
import socket
import struct
import subprocess
import sys
import threading
import time

HOME = os.path.expanduser("~")
BACKEND = os.path.join(HOME, ".bitwarden-ssh-agent.sock")
LISTEN = os.path.join(HOME, ".bitwarden-ssh-agent-notify.sock")
SSH2_AGENTC_SIGN_REQUEST = 13
DEBOUNCE_SEC = 8.0
MAX_MSG = 256 * 1024

_last_alert = 0.0
_last_lock = threading.Lock()
SO_PEERCRED = 17  # Linux
NOTIFY_TITLE = "Bitwarden SSH"
NOTIFY_BODY = "Authorize the SSH key in Bitwarden Desktop"


def recvall(sock: socket.socket, n: int) -> bytes | None:
    buf = bytearray()
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf.extend(chunk)
    return bytes(buf)


def read_agent_frame(sock: socket.socket) -> bytes | None:
    hdr = recvall(sock, 4)
    if not hdr:
        return None
    (length,) = struct.unpack(">I", hdr)
    if length == 0 or length > MAX_MSG:
        return None
    body = recvall(sock, length)
    if body is None:
        return None
    return hdr + body


def peer_pid(sock: socket.socket) -> int | None:
    try:
        creds = sock.getsockopt(socket.SOL_SOCKET, SO_PEERCRED, struct.calcsize("3i"))
    except OSError:
        return None
    pid, _uid, _gid = struct.unpack("3i", creds)
    return pid if pid > 0 else None


def write_to_peer_tty(pid: int, payload: bytes) -> None:
    for fd in (2, 1, 0):
        try:
            out = os.open(f"/proc/{pid}/fd/{fd}", os.O_WRONLY | os.O_NOCTTY)
        except OSError:
            continue
        try:
            os.write(out, payload)
            return
        except OSError:
            continue
        finally:
            os.close(out)


def wezterm_alert_bytes() -> bytes:
    # OSC 777 is WezTerm's in-app notification; BEL flashes visual_bell.
    return (
        b"\033]777;notify;"
        + NOTIFY_TITLE.encode()
        + b";"
        + NOTIFY_BODY.encode()
        + b"\033\\\a"
    )


def raise_bitwarden() -> None:
    display = os.environ.get("DISPLAY") or ":0"
    xdotool = "/usr/bin/xdotool"
    if not os.access(xdotool, os.X_OK):
        return
    env = os.environ.copy()
    env["DISPLAY"] = display
    subprocess.Popen(
        [
            xdotool,
            "search",
            "--onlyvisible",
            "--class",
            "bitwarden",
            "windowactivate",
            "windowraise",
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        env=env,
    )


def alert(client: socket.socket | None = None, *, force: bool = False) -> None:
    global _last_alert
    now = time.monotonic()
    with _last_lock:
        if not force and now - _last_alert < DEBOUNCE_SEC:
            return
        _last_alert = now
    payload = wezterm_alert_bytes()
    pid = peer_pid(client) if client is not None else None
    if pid:
        write_to_peer_tty(pid, payload)
    elif sys.stdout.isatty():
        sys.stdout.buffer.write(payload)
        sys.stdout.buffer.flush()
    raise_bitwarden()


def pipe_backend_to_client(backend: socket.socket, client: socket.socket) -> None:
    try:
        while True:
            data = backend.recv(65536)
            if not data:
                break
            client.sendall(data)
    except OSError:
        pass
    finally:
        try:
            client.shutdown(socket.SHUT_WR)
        except OSError:
            pass


def handle_client(client: socket.socket) -> None:
    backend = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        deadline = time.time() + 5
        while True:
            try:
                backend.connect(BACKEND)
                break
            except OSError:
                if time.time() >= deadline:
                    return
                time.sleep(0.2)
        t = threading.Thread(target=pipe_backend_to_client, args=(backend, client), daemon=True)
        t.start()
        while True:
            frame = read_agent_frame(client)
            if frame is None:
                break
            if len(frame) >= 5 and frame[4] == SSH2_AGENTC_SIGN_REQUEST:
                alert(client)
            backend.sendall(frame)
        t.join(timeout=2)
    except OSError:
        pass
    finally:
        try:
            backend.close()
        except OSError:
            pass
        try:
            client.close()
        except OSError:
            pass


def main() -> int:
    if len(sys.argv) > 1 and sys.argv[1] in ("--test", "-t"):
        alert(None, force=True)
        return 0

    os.makedirs(HOME, exist_ok=True)
    if os.path.exists(LISTEN):
        try:
            os.unlink(LISTEN)
        except OSError:
            pass

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(LISTEN)
    os.chmod(LISTEN, 0o600)
    server.listen(16)
    server.settimeout(1.0)

    while True:
        try:
            client, _ = server.accept()
        except (TimeoutError, socket.timeout):
            continue
        except KeyboardInterrupt:
            break
        threading.Thread(target=handle_client, args=(client,), daemon=True).start()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
