# ~/.bashrc — load order only. Aliases/functions live in ~/.config/bash/.

# If not running interactively, don't do anything
case $- in
  *i*) ;;
  *) return ;;
esac

export EDITOR=nvim
export VISUAL=nvim
export GIT_EDITOR=nvim

# User binaries first among user paths
export PATH="$HOME/.opencode/bin:$HOME/.local/bin:${PATH}"

# ble.sh (attach at end) — AUR path first, then local fallback install
if [[ -f /usr/share/blesh/ble.sh ]]; then
  # shellcheck disable=SC1091
  source /usr/share/blesh/ble.sh --attach=none
elif [[ -f "$HOME/.local/share/blesh/ble.sh" ]]; then
  # shellcheck disable=SC1091
  source "$HOME/.local/share/blesh/ble.sh" --attach=none
fi

# bash-completion (before fzf via ble)
if [[ -r /usr/share/bash-completion/bash_completion ]]; then
  # shellcheck disable=SC1091
  . /usr/share/bash-completion/bash_completion
elif [[ -r /etc/bash_completion ]]; then
  # shellcheck disable=SC1091
  . /etc/bash_completion
fi

# mise → direnv → zoxide → starship
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

if command -v direnv >/dev/null 2>&1; then
  eval "$(direnv hook bash)"
fi

if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init bash)"
fi

if command -v starship >/dev/null 2>&1; then
  eval "$(starship init bash)"
fi

# Bitwarden SSH agent (Linux-native). Unlock Arch Bitwarden before ssh/git.
export SSH_AUTH_SOCK="${HOME}/.bitwarden-ssh-agent.sock"

# Open OAuth/docs in the Windows browser (appendWindowsPath=false → no cmd.exe on PATH).
export BROWSER="${HOME}/.local/bin/windows-open"
export GH_BROWSER="${BROWSER}"

# UX defaults
if command -v fd >/dev/null 2>&1; then
  export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'
  export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi
# Always case-insensitive (fzf default is smart-case: uppercase makes it sensitive).
export FZF_DEFAULT_OPTS="${FZF_DEFAULT_OPTS:+$FZF_DEFAULT_OPTS }--ignore-case"
export BAT_THEME="${BAT_THEME:-tokyonight_night}"

# Aliases / functions (chezmoi-managed + optional local overrides)
[[ -f ~/.config/bash/aliases.sh ]] && . ~/.config/bash/aliases.sh
[[ -f ~/.config/bash/functions.sh ]] && . ~/.config/bash/functions.sh
[[ -f ~/.config/bash/aliases.local.sh ]] && . ~/.config/bash/aliases.local.sh

# Attach ble.sh last
[[ ${BLE_VERSION-} ]] && ble-attach
