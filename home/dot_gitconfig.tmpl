# Managed by chezmoi — personal defaults; org profiles via remote URL (hasconfig)

[user]
	name = {{ .git.name | quote }}
	email = {{ .git.email | quote }}
{{- if stat (joinPath .chezmoi.homeDir ".ssh/home-personal.pub") }}
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh/home-personal.pub" | quote }}
{{- end }}

[init]
	defaultBranch = main

{{- if stat (joinPath .chezmoi.homeDir ".ssh/home-personal.pub") }}
[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = {{ joinPath .chezmoi.homeDir ".ssh/allowed_signers" | quote }}

[commit]
	gpgsign = true

[tag]
	gpgsign = true
{{- end }}

{{- range $key, $val := .git }}
{{- if and (kindIs "map" $val) (index $val "ssh_host") }}
{{- $sshHost := index $val "ssh_host" }}
{{- if $sshHost }}

# Stored remote stays git@github.com:{{ $key }}/repo.git; SSH uses Host {{ $sshHost }}.
[url "git@{{ $sshHost }}:{{ $key }}/"]
	insteadOf = git@github.com:{{ $key }}/
	insteadOf = ssh://git@github.com/{{ $key }}/
	insteadOf = https://github.com/{{ $key }}/
{{- end }}
{{- end }}
{{- end }}
{{- range $key, $val := .git }}
{{- if and (kindIs "map" $val) (index $val "name") (index $val "email") }}

# Same remote prefix as insteadOf: name/email/signing follow git@github.com:{{ $key }}/ (Git 2.36+).
[includeIf "hasconfig:remote.*.url:git@github.com:{{ $key }}/**"]
	path = ~/.config/git/config-{{ $key }}
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/{{ $key }}/**"]
	path = ~/.config/git/config-{{ $key }}
[includeIf "hasconfig:remote.*.url:https://github.com/{{ $key }}/**"]
	path = ~/.config/git/config-{{ $key }}
{{- end }}
{{- end }}
