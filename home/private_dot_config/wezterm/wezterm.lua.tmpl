{{- $t := index .themes .theme -}}
-- WezTerm config (managed by chezmoi)
-- Theme: {{ .theme }}
-- Arch WSL / WSLg: stay on X11. Wayland hits Mesa ZINK / libvulkan.so.1 / EGL
-- failures and, with hide_tab_bar_if_only_one_tab, a borderless panel.
-- Do not assign nightly-only keys through config_builder() — unknown fields
-- abort startup on extra/wezterm (stable).

local wezterm = require("wezterm")
local config = wezterm.config_builder()

config.color_scheme = {{ index $t "wezterm" | quote }}
config.font = wezterm.font("JetBrainsMono Nerd Font")
config.font_size = 12.0
config.hide_tab_bar_if_only_one_tab = true
config.window_padding = { left = 8, right = 8, top = 6, bottom = 6 }
config.enable_wayland = false
config.window_decorations = "TITLE | RESIZE"

return config
